{
  "name": "@keeper.sh/calendar",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./caldav": "./src/providers/caldav/index.ts",
    "./google": "./src/providers/google/index.ts",
    "./outlook": "./src/providers/outlook/index.ts",
    "./zoho": "./src/providers/zoho/index.ts",
    "./fastmail": "./src/providers/fastmail/index.ts",
    "./icloud": "./src/providers/icloud/index.ts",
    "./ics": "./src/ics/index.ts",
    "./safe-fetch": "./src/utils/safe-fetch.ts",
    "./digest-fetch": "./src/providers/caldav/shared/digest-fetch.ts"
  },
  "scripts": {
    "types": "tsc --noEmit",
    "test": "TZ=UTC bun x --bun vitest run",
    "coverage": "TZ=UTC bun x --bun vitest run --coverage --coverage.provider=istanbul --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.include=src/** --coverage.exclude=**/*.test.ts",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@keeper.sh/constants": "workspace:*",
    "@keeper.sh/data-schemas": "workspace:*",
    "@keeper.sh/database": "workspace:*",
    "@keeper.sh/digest-fetch": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.10.0",
    "ipaddr.js": "^2.3.0",
    "tldts": "^7.0.27",
    "ts-ics": "^2.4.3",
    "tsdav": "^2.1.8"
  },
  "devDependencies": {
    "@keeper.sh/fixtures": "workspace:*",
    "@keeper.sh/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  }
}
